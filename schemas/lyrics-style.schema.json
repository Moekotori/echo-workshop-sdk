        },
        "maxHeight": {
          "$ref": "#/$defs/styleValue"
        },
        "margin": {
          "$ref": "#/$defs/styleValue"
        },
        "marginTop": {
          "$ref": "#/$defs/styleValue"
        },
        "marginRight": {
          "$ref": "#/$defs/styleValue"
        },
        "marginBottom": {
          "$ref": "#/$defs/styleValue"
        },
        "marginLeft": {
          "$ref": "#/$defs/styleValue"
        },
        "padding": {
          "$ref": "#/$defs/styleValue"
        },
        "paddingTop": {
          "$ref": "#/$defs/styleValue"
        },
        "paddingRight": {
          "$ref": "#/$defs/styleValue"
        },
        "paddingBottom": {
          "$ref": "#/$defs/styleValue"
        },
        "paddingLeft": {
          "$ref": "#/$defs/styleValue"
        },
        "overflow": {
          "enum": [
            "visible",
            "hidden",
            "auto",
            "scroll"
          ]
        },
        "overflowX": {
          "enum": [
            "visible",
            "hidden",
            "auto",
            "scroll"
          ]
        },
        "overflowY": {
          "enum": [
