            "flex-end",
            "baseline"
          ]
        },
        "justifyContent": {
          "enum": [
            "flex-start",
            "center",
            "flex-end",
            "space-between",
            "space-around",
            "space-evenly"
          ]
        },
        "justifyItems": {
          "enum": [
            "stretch",
            "start",
            "center",
            "end"
          ]
        },
        "justifySelf": {
          "enum": [
            "auto",
            "stretch",
            "start",
            "center",
            "end"
          ]
        },
        "placeContent": {
          "enum": [
            "stretch",
            "start",
            "center",
            "end",
            "space-between",
            "space-around",
            "space-evenly"
          ]
        },
        "placeItems": {
          "enum": [
            "stretch",
            "start",
            "center",
            "end"
          ]
        },
        "placeSelf": {
          "enum": [
            "auto",
            "stretch",
            "start",
            "center",
            "end"
          ]
        },
        "flex": {
          "$ref": "#/$defs/styleValue"
        },
        "flexGrow": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "flexShrink": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "flexBasis": {
          "$ref": "#/$defs/styleValue"
        },
        "order": {
          "type": "number",
          "minimum": -64,
          "maximum": 64
        },
        "gridTemplateColumns": {
          "$ref": "#/$defs/styleValue"
        },
        "gridTemplateRows": {
          "$ref": "#/$defs/styleValue"
        },
        "gridTemplateAreas": {
          "$ref": "#/$defs/styleValue"
        },
        "gridAutoColumns": {
          "$ref": "#/$defs/styleValue"
        },
        "gridAutoRows": {
          "$ref": "#/$defs/styleValue"
        },
        "gridAutoFlow": {
          "enum": [
            "row",
            "column",
            "dense",
            "row dense",
            "column dense"
          ]
        },
        "gridColumn": {
          "$ref": "#/$defs/styleValue"
        },
        "gridColumnStart": {
          "$ref": "#/$defs/styleValue"
        },
        "gridColumnEnd": {
          "$ref": "#/$defs/styleValue"
        },
        "gridRow": {
          "$ref": "#/$defs/styleValue"
        },
        "gridRowStart": {
          "$ref": "#/$defs/styleValue"
        },
        "gridRowEnd": {
          "$ref": "#/$defs/styleValue"
        },
        "gap": {
          "$ref": "#/$defs/styleValue"
        },
        "rowGap": {
          "$ref": "#/$defs/styleValue"
        },
        "columnGap": {
          "$ref": "#/$defs/styleValue"
        },
        "width": {
          "$ref": "#/$defs/styleValue"
        },
        "height": {
          "$ref": "#/$defs/styleValue"
        },
        "minWidth": {
          "$ref": "#/$defs/styleValue"
        },
        "maxWidth": {
          "$ref": "#/$defs/styleValue"
        },
        "minHeight": {
