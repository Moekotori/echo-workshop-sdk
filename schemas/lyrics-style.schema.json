{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echo.example/schemas/workshop/lyrics-style.schema.json",
  "title": "ECHO Workshop lyrics style",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "schemaVersion",
    "id",
    "title"
  ],
  "properties": {
    "type": {
      "const": "echo-workshop-lyrics-style"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lyricsPageStyle": {
          "enum": [
            "default",
            "luminous",
            "afterglowCover",
            "editorial",
            "folded",
            "roseVinyl",
            "cinemaStage",
            "kineticPoster",
            "coverStage",
            "cutBoard",
            "jizura"
          ]
        },
        "lyricsFontSizePx": {
          "type": "number",
          "minimum": 16,
          "maximum": 96
        },
        "lyricsSecondaryFontSizePx": {
          "type": "number",
          "minimum": 10,
          "maximum": 64
        },
        "lyricsLineSpacingPercent": {
          "type": "number",
          "minimum": 80,
          "maximum": 240
        },
        "lyricsContextOpacityPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "lyricsCoverOpacityPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "lyricsCoverBlurPx": {
          "type": "number",
          "minimum": 0,
          "maximum": 80
        },
        "lyricsCoverBrightnessPercent": {
          "type": "number",
          "minimum": 20,
          "maximum": 150
        },
        "lyricsBackgroundScalePercent": {
          "type": "number",
          "minimum": 100,
          "maximum": 160
        },
        "lyricsSmartReadableColorsEnabled": {
          "type": "boolean"
        },
        "lyricsWordHighlightEnabled": {
          "type": "boolean"
        },
        "lyricsImmersiveCoverStyleEnabled": {
          "type": "boolean"
        },
        "lyricsImmersiveCoverGlassEnabled": {
          "type": "boolean"
        },
        "lyricsMusicReactiveVisualsEnabled": {
          "type": "boolean"
        },
        "lyricsColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "lyricsBackgroundMode": {
          "enum": [
            "theme",
            "cover",
            "coverColor"
          ]
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "background",
        "root"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "background": {
          "enum": [
            "theme",
            "cover",
            "cover-blur",
            "cover-color",
            "transparent",
            "asset"
          ]
        },
        "backgroundAsset": {
          "type": "string"
        },
        "hostChrome": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "miniPlayer": {
              "enum": [
                "visible",
                "hidden"
              ]
            },
            "backButton": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sizePx": {
                  "type": "number",
                  "minimum": 32,
                  "maximum": 80
                },
                "borderRadiusPx": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 40
                },
                "color": {
                  "type": "string",
                  "maxLength": 240
                },
                "backgroundColor": {
                  "type": "string",
                  "maxLength": 240
                },
                "borderColor": {
                  "type": "string",
                  "maxLength": 240
                }
              }
            }
          }
        },
        "root": {
          "allOf": [
            {
              "$ref": "#/$defs/node"
            },
            {
              "properties": {
                "type": {
                  "const": "group"
                }
              }
            }
          ]
        },
        "afterglow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "scenes"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "mode": {
              "enum": [
                "mix",
                "only"
              ]
            },
            "scenes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "title",
                  "layers"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "layers": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 64,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type"
                      ],
                      "properties": {
                        "type": {
                          "enum": [
                            "circle",
                            "ellipse",
                            "rect",
                            "line",
                            "polygon",
                            "text",
                            "particles"
                          ]
                        },
                        "x": {
                          "type": "number",
                          "minimum": -1,
                          "maximum": 2
                        },
                        "y": {
                          "type": "number",
                          "minimum": -1,
                          "maximum": 2
                        },
                        "width": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 2
                        },
                        "height": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 2
                        },
                        "radius": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 2
                        },
                        "color": {
                          "type": "string",
                          "pattern": "^(transparent|bg|fg|accent|accent2|ghostA|ghostB|#[0-9a-fA-F]{6})$"
                        },
                        "stroke": {
                          "type": "string",
                          "pattern": "^(transparent|bg|fg|accent|accent2|ghostA|ghostB|#[0-9a-fA-F]{6})$"
                        },
                        "opacity": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "rotation": {
                          "type": "number",
                          "minimum": -6.283185307179586,
                          "maximum": 6.283185307179586
                        },
                        "strokeWidth": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 0.05
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 120
                        },
                        "fontSize": {
                          "type": "number",
                          "minimum": 0.005,
                          "maximum": 0.2
                        },
                        "count": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 80
                        },
                        "points": {
                          "type": "array",
                          "minItems": 3,
                          "maxItems": 32,
                          "items": {
                            "type": "array",
                            "minItems": 2,
                            "maxItems": 2,
                            "items": {
                              "type": "number",
                              "minimum": -2,
                              "maximum": 2
                            }
                          }
                        },
                        "motion": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "floatX": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 0.25
                            },
                            "floatY": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 0.25
                            },
                            "speed": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 3
                            },
                            "spin": {
                              "type": "number",
                              "minimum": -0.5,
                              "maximum": 0.5
                            },
                            "phase": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 6.283185307179586
                            }
                          }
                        }
                      },
                      "allOf": [
                        {
                          "if": {
                            "properties": {
                              "type": {
                                "const": "text"
                              }
                            }
                          },
                          "then": {
                            "required": [
                              "text"
                            ]
                          }
                        },
                        {
                          "if": {
                            "properties": {
                              "type": {
                                "const": "polygon"
                              }
                            }
                          },
                          "then": {
                            "required": [
                              "points"
                            ]
                          }
                        },
                        {
                          "if": {
                            "properties": {
                              "type": {
                                "const": "particles"
                              }
                            }
                          },
                          "then": {
                            "properties": {
                              "radius": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 0.02
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position": {
          "enum": [
            "relative",
            "absolute"
          ]
        },
        "inset": {
          "$ref": "#/$defs/styleValue"
        },
        "top": {
          "$ref": "#/$defs/styleValue"
        },
        "right": {
          "$ref": "#/$defs/styleValue"
        },
        "bottom": {
          "$ref": "#/$defs/styleValue"
        },
        "left": {
          "$ref": "#/$defs/styleValue"
        },
        "zIndex": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "boxSizing": {
          "enum": [
