            "animationId": {
              "type": "string"
            }
          },
          "required": [
            "itemId",
            "animationId"
          ]
        },
        "durationMs": {
          "type": "number",
          "minimum": 80,
          "maximum": 30000
        },
        "delayMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 30000
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "loop": {
          "type": "boolean"
        },
        "sequence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            }
          },
          "required": [
            "index",
            "count"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "preset"
          ]
        },
        {
          "required": [
            "library"
          ]
        }
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "type": {
          "enum": [
            "group",
            "slot",
            "text",
            "decoration",
            "image"
          ]
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "responsive": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "compact": {
              "$ref": "#/$defs/style"
            },
            "wide": {
              "$ref": "#/$defs/style"
            }
          }
        },
        "motion": {
          "$ref": "#/$defs/motion"
        },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hasCover": {
              "type": "boolean"
            },
            "hasLyrics": {
              "type": "boolean"
            },
            "isPlaying": {
              "type": "boolean"
            },
            "hasAlbum": {
              "type": "boolean"
            },
            "isShuffle": {
              "type": "boolean"
            },
            "isRepeat": {
              "type": "boolean"
            },
            "isLiked": {
              "type": "boolean"
            }
          }
        },
        "children": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "slot": {
          "enum": [
            "cover",
            "title",
            "artist",
            "album",
            "lyrics",
            "current-line",
            "previous-line",
            "next-line",
            "translation",
            "progress",
            "seek-bar",
            "time-current",
            "time-duration",
            "spectrum",
            "status",
            "track-tech",
            "play-toggle",
            "previous-track",
            "next-track",
            "volume-slider",
            "shuffle-toggle",
            "repeat-cycle",
            "like-toggle"
          ]
        },
        "options": {
          "$ref": "#/$defs/options"
        },
        "text": {
          "type": "string",
          "maxLength": 240
        },
        "asset": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "group"
              }
            }
          },
          "then": {
            "required": [
              "children"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "slot"
              }
            }
          },
          "then": {
            "required": [
              "slot"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "image"
              }
            }
          },
          "then": {
            "required": [
              "asset"
            ]
          }
        }
      ]
    },
    "styleValue": {
      "anyOf": [
        {
          "type": "number",
          "minimum": -4096,
          "maximum": 4096
        },
        {
          "type": "string",
          "maxLength": 240,
          "pattern": "^[^;{}<>\\\\]*$"
        }
      ]
    }
  }
}
