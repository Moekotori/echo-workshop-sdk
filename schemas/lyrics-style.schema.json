        },
        "outline": {
          "$ref": "#/$defs/styleValue"
        },
        "boxShadow": {
          "$ref": "#/$defs/styleValue"
        },
        "backdropFilter": {
          "$ref": "#/$defs/styleValue"
        },
        "filter": {
          "$ref": "#/$defs/styleValue"
        },
        "mixBlendMode": {
          "enum": [
            "normal",
            "multiply",
            "screen",
            "overlay",
            "darken",
            "lighten",
            "color-dodge",
            "color-burn",
            "hard-light",
            "soft-light",
            "difference",
            "exclusion",
            "hue",
            "saturation",
            "color",
            "luminosity"
          ]
        },
