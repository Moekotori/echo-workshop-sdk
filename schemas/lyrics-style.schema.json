            "hidden",
            "auto",
            "scroll"
          ]
        },
        "visibility": {
          "enum": [
            "visible",
            "hidden"
          ]
        },
        "color": {
          "$ref": "#/$defs/styleValue"
        },
        "background": {
          "$ref": "#/$defs/styleValue"
        },
        "backgroundColor": {
          "$ref": "#/$defs/styleValue"
        },
        "backgroundImage": {
          "$ref": "#/$defs/styleValue"
        },
        "backgroundPosition": {
          "$ref": "#/$defs/styleValue"
        },
        "backgroundSize": {
