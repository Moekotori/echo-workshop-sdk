{
  "sdkVersion": 1,
  "packageVersion": "1.19.0",
  "manifest": {
    "type": "echo-workshop-item",
    "schemaVersions": [1],
    "contentKinds": [
      "theme",
      "lyrics-style",
      "animation-library",
      "visualizer-preset",
      "dsp-preset",
      "audio-plugin-profile",
      "locale-pack",
      "plugin-package",
      "native-shell"
    ]
  },
  "plugin": {
    "apiVersions": [1, 2],
    "currentApiVersion": 2,
    "declarationFile": "echo-workshop-plugin.d.ts",
    "contractFile": "contracts/plugin-api.json",
    "trustedRuntime": {
      "permission": "system:full",
      "entryField": "manifest.trustedEntry",
      "entryExtension": ".mjs",
      "minimumEchoVersion": "26.8.29",
      "execution": "isolated-utility-process",
      "moduleExports": ["activate", "handle", "dispose"]
    },
    "offlineProcessing": {
      "permissions": ["audio:offline-read", "fs:export"],
      "sampleFormat": "s16le",
      "sampleRateRange": [8000, 48000],
      "channels": [1, 2],
      "externalAssetDirectory": "assets/",
      "externalAssetExtensions": [".wasm", ".onnx", ".bin", ".data"],
      "maximumExternalAssetFileBytes": null,
      "maximumExternalAssetBytes": null
    }
  },
  "theme": {
    "presets": ["colors", "skin", "stylesheet", "runtime"],
    "stylesheetMinEchoVersion": "26.8.20",
    "partsContract": "contracts/theme-parts.json",
    "partsApiVersion": 1,
    "uiRuntimeProtocolVersion": 1,
    "declarationFile": "echo-workshop-ui-runtime.d.ts"
  },
  "lyricsStyle": {
    "presets": ["editorial", "compact", "cinema", "cover", "afterglow"],
    "afterglow": {
      "schemaVersion": 1,
      "minimumEchoVersion": "26.9.29",
      "declarationFile": "echo-workshop-afterglow.d.ts",
      "contractFile": "contracts/afterglow-scenes.json",
      "guide": "afterglow-scenes.md"
    }
  },
  "animationLibrary": {
    "schemaVersion": 1,
    "minimumEchoVersion": "26.9.1",
    "declarationFile": "echo-workshop-animation-library.d.ts",
    "maximumAnimations": 64,
    "maximumKeyframesPerAnimation": 8,
    "properties": ["opacity", "translateX", "translateY", "translateZ", "scale", "rotateXDeg", "rotateYDeg", "rotateDeg", "skewXDeg", "skewYDeg", "clipProgress"],
    "triggers": ["scene-enter", "track-change", "line-change", "ambient"],
    "origins": ["center", "top", "right", "bottom", "left", "top-left", "top-right", "bottom-right", "bottom-left"],
    "clipDirections": ["left-to-right", "right-to-left", "top-to-bottom", "bottom-to-top", "center-out-x", "center-out-y"],
    "staggerOrigins": ["first", "center", "last", "edges"],
    "easings": ["linear", "ease", "ease-in", "ease-out", "ease-in-out", "echo-spring", "echo-snappy", "echo-gentle", "echo-elastic"]
  },
  "visualizer": {
    "presets": ["bars", "wave", "radial"]
  },
  "dsp": {
    "presets": ["flat", "vocal", "bass", "8bit"],
    "bandCount": 31,
    "audioEffects": {
      "bitcrusher": {
        "placement": "post-rack-pre-headroom",
        "parameters": ["bitDepth", "sampleRateHz", "mix", "outputGainDb"]
      },
      "chiptune": {
        "placement": "post-rack-pre-headroom",
        "parameters": ["bitDepth", "sampleRateHz", "mix", "outputGainDb", "pulseMix", "triangleMix", "noiseMix", "drive"]
      },
      "vocalCut": {
        "placement": "post-rack-pre-headroom",
        "parameters": ["mix", "outputGainDb", "vocalCutStrength", "vocalCutBassPreserveHz"],
        "vocalCutBassPreserveHzRange": [80, 300]
      }
    }
  },
  "recipes": [
    "css-theme",
    "custom-ui",
    "skin-theme",
    "cinema-lyrics",
    "compact-lyrics",
    "cover-lyrics",
    "radial-visualizer",
    "wave-visualizer",
    "vocal-eq",
    "bass-eq",
    "8bit-audio",
    "plugin-complete",
    "full-trust-plugin",
    "source-catalog",
    "lyrics-source",
    "wenyan-locale",
    "colors-theme",
    "editorial-lyrics",
    "bars-visualizer",
    "native-shell-taskbar"
  ],
  "nativeShell": {
    "protocolVersions": [1],
    "currentProtocolVersion": 1,
    "declarationFile": "echo-workshop-native-shell.d.ts",
    "contractFile": "contracts/native-shell.json",
    "limitsFile": "contracts/native-shell-limits.json"
  },
  "audioPluginAdapter": {
    "api": "echo.audio-plugin-adapter",
    "protocolVersions": [1]
  }
}
