{
  "domain": "library",
  "permissions": ["library:playlist-delete", "library:personal-write"],
  "apiVersion": 2,
  "minimumEchoVersion": "26.10.18",
  "surfaces": [
    "plugin",
    "theme"
  ],
  "owner": "Library Core via typed library API",
  "events": {
    "library:changed": {
      "permission": "library:read",
      "payload": "null",
      "meaning": "Refresh affected visible library, playlist and personal-library queries."
    },
    "library:liked-changed": {
      "permission": "library:read",
      "payload": "null",
      "meaning": "Refresh visible favorite states."
    }
  },
  "limits": {
    "pageSize": 100,
    "batchIds": 200,
    "smartResultTracks": 100,
    "smartPlaylistTracks": 1000,
    "maximumConditionNodes": 256
  },
  "queryEnums": {
    "sort": [
      "default",
      "createdAsc",
      "createdDesc",
      "yearAsc",
      "yearDesc",
      "titleAsc",
      "titleDesc",
      "trackCountAsc",
      "trackCountDesc",
      "albumCountDesc",
      "durationAsc",
      "durationDesc",
      "fileModifiedAsc",
      "fileModifiedDesc",
      "qualityAsc",
      "qualityDesc",
      "codecAsc",
      "codecDesc",
      "audioSpecAsc",
      "audioSpecDesc",
      "bitrateAsc",
      "bitrateDesc",
      "bpmAsc",
      "bpmDesc",
      "trackNumber",
      "frequent",
      "playCountAsc",
      "playCountDesc",
      "lastPlayed",
      "random",
      "title",
      "artist",
      "artistDesc",
      "artistAlbum",
      "album",
      "albumDesc",
      "recent",
      "addedAsc"
    ],
    "audioFormatFilter": [
      "all",
      "sampleRate44100",
      "sampleRate48000",
      "sampleRate88200",
      "sampleRate96000",
      "sampleRate176400",
      "sampleRate192000",
      "sampleRate352800",
      "sampleRate384000",
      "dsd",
      "otherSampleRate"
    ],
    "fileFormatFilter": [
      "all",
      "flac",
      "mp3",
      "wav",
      "aiff",
      "alac",
      "aac",
      "ogg",
      "opus",
      "dsd",
      "other"
    ],
    "vocalFilter": [
      "all",
      "instrumental",
      "excludeInstrumental"
    ],
    "lyricsFilter": [
      "all",
      "withLyrics",
      "withoutLyrics",
      "withWordTiming",
      "withoutWordTiming"
    ],
    "artistGrouping": [
      "split",
      "albumArtist"
    ],
    "duplicateMode": [
      "strict",
      "balanced",
      "aggressive"
    ]
  },
  "queryBooleans": [
    "hideDuplicates",
    "showDuplicatesOnly",
    "showOsuOnly",
    "excludeOsuAlbums",
    "collapseAlbumVersions"
